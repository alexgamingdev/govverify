{
  "manifest_version": 3,
  "name": "GovVerify",
  "version": "1.0.0",
  "description": "Verifiziert Webseiten über eine remote geladene JSON-Datei und warnt vor Klon-Seiten.",
  "action": {
    "default_title": "GovVerify",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://alexgamingdev.github.io/govverify/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ]
}